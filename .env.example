PORT=8787
BRIDGE_PASSWORD=troque-esta-senha
BRIDGE_SESSION_SECRET=troque-este-segredo-longo

# cdp = controla o Cursor IDE aberto (sem API key)
# sdk = Agent.create via CURSOR_API_KEY (sessão paralela)
BRIDGE_BACKEND=cdp
CURSOR_CDP_URL=http://127.0.0.1:9222
# Deve bater com o título da janela Cursor (geralmente o nome da pasta do workspace)
CURSOR_CDP_TARGET=seu-projeto
CDP_POLL_MS=400
# Soft window / extension slice while the agent is still working (not a hard wall).
CDP_TIMEOUT_MS=600000
# Absolute cap for a single CDP turn (default 45 min).
CDP_MAX_TIMEOUT_MS=2700000

# Só necessário com BRIDGE_BACKEND=sdk
CURSOR_API_KEY=cursor_...
CURSOR_CWD=/caminho/absoluto/do/seu-projeto
CURSOR_MODEL=composer-2.5

# Túnel público (usado por ./start-local.sh)
# cloudflare = hostname fixo (recomendado para o time)
# ngrok = URL efêmera (ad-hoc)
TUNNEL_PROVIDER=ngrok
# CLOUDFLARED_BIN=cloudflared
# CLOUDFLARE_TUNNEL_NAME=cursor-web-bridge
# Ou path absoluto do config com ingress (alternativa a CLOUDFLARE_TUNNEL_NAME):
# CLOUDFLARE_CONFIG=/home/voce/.cloudflared/config.yml
# URL fixa impressa no start (não altera o Node; só para o operador compartilhar):
# BRIDGE_PUBLIC_URL=https://bridge.example.com

# Live WebRTC (opcional). STUN default do Google.
# RTC_STUN_URLS=stun:stun.l.google.com:19302
# Para NATs difíceis (túnel entre redes), configure um TURN:
# RTC_TURN_URLS=turn:turn.exemplo.com:3478
# RTC_TURN_USER=user
# RTC_TURN_PASS=pass
