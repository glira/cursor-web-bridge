PORT=8787
BRIDGE_PASSWORD=change-this-password
BRIDGE_SESSION_SECRET=change-this-long-secret

# cdp = drive the open Cursor IDE (no API key)
# sdk = Agent.create via CURSOR_API_KEY (parallel session)
BRIDGE_BACKEND=cdp
CURSOR_CDP_URL=http://127.0.0.1:9222
# Must match the Cursor window title (usually the workspace folder name)
CURSOR_CDP_TARGET=your-project
CDP_POLL_MS=400
# Soft window / extension slice while the agent is still working (not a hard wall).
CDP_TIMEOUT_MS=600000
# Absolute cap for a single CDP turn (default 45 min).
CDP_MAX_TIMEOUT_MS=2700000

# Only required with BRIDGE_BACKEND=sdk
CURSOR_API_KEY=cursor_...
CURSOR_CWD=/absolute/path/to/your-project
CURSOR_MODEL=composer-2.5

# Public tunnel (used by ./start-local.sh)
# cloudflare = fixed hostname (recommended for a team)
# ngrok = ephemeral URL (ad-hoc)
TUNNEL_PROVIDER=ngrok
# CLOUDFLARED_BIN=cloudflared
# CLOUDFLARE_TUNNEL_NAME=cursor-web-bridge
# Or absolute path to a config with ingress (instead of CLOUDFLARE_TUNNEL_NAME):
# CLOUDFLARE_CONFIG=/home/you/.cloudflared/config.yml
# Fixed URL printed at start (does not change Node; operator share only):
# BRIDGE_PUBLIC_URL=https://bridge.example.com

# Live WebRTC (optional). Default Google STUN.
# RTC_STUN_URLS=stun:stun.l.google.com:19302
# For difficult NATs (tunnel across networks), configure TURN:
# RTC_TURN_URLS=turn:turn.example.com:3478
# RTC_TURN_USER=user
# RTC_TURN_PASS=pass
